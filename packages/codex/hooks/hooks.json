{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/hook.js\"",
            "command_windows": "node \"%PLUGIN_ROOT%\\dist\\hook.js\"",
            "timeout": 20,
            "statusMessage": "Running KeepNow command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.*keepnow.*__keepnow_",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/hook.js\"",
            "command_windows": "node \"%PLUGIN_ROOT%\\dist\\hook.js\"",
            "timeout": 10,
            "statusMessage": "Attaching KeepNow session"
          }
        ]
      }
    ]
  }
}
